# Copy to .env.local and fill in. Never commit .env.local.

# Google AI Studio key (https://aistudio.google.com/apikey). Server-side only.
# If missing, embeddings fall back to a local keyword-hash so seeding still works.
GEMINI_API_KEY=

# TiDB Cloud Serverless: Cluster > Connect > "General" > copy the mysql:// URL.
# Format: mysql://USER.root:PASSWORD@gateway01.us-west-2.prod.aws.tidbcloud.com:4000/sidequest
DATABASE_URL=

# Optional, Phase 5 narrator.
ELEVENLABS_API_KEY=

# Shows the "Demo: switch user" dropdown so one laptop can play both sides.
NEXT_PUBLIC_DEMO_MODE=true
