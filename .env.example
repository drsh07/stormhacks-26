# Copy to .env, then restart `npx expo start` (env changes need a restart).

# Where the SideQuest backend (the Next.js project) is running. No trailing slash.
# - Deployed:            https://your-app.vercel.app
# - Phone on same Wi-Fi:  http://YOUR-LAPTOP-IP:3000  (the "Network" address `npm run dev` prints)
# - iOS simulator / web:  http://localhost:3000
EXPO_PUBLIC_API_URL=http://localhost:3000

# Shows the "Demo: switch user" control so one phone can play both sides.
EXPO_PUBLIC_DEMO_MODE=true
